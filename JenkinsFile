pipeline {
    agent any
    stages {
        stage('Clonage du dépôt GitHub') {
            steps {
                git branch: 'dev', url: "https://github.com/Abdel1117/OSDetectorFork"
            }
        }
        stage('Exécution dans Docker') {
            steps {
                script {
                    // Remplacez 'custom-jenkins' par l'image souhaitée
                    docker.image('custom-jenkins').inside('--user root') {
                        sh 'apt-get update'
                        sh 'apt-get install -y python3 python3-pip'
                        // Autres commandes...
                    }
                }
            }
        }
    }
}
