pipeline {
    agent any
        stages {
            stage('Clonage du dépôt GitHub') {
                steps {
                    git branch: dev, url : "https://github.com/Abdel1117/OSDetectorFork"
                    }
                }
        }
        stages{
            stage("Installation de python 3")
            {
                steps{
                    sh 'sudo apt-get update'
                    sh 'sudo apt-get install python3'
                }
            }
        }
        stages{
            stage("Installation de pip")
            {
                steps{
                    sh 'sudo apt-get install python3-pip'
                }
            }
        }

}